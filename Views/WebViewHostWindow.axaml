<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CursorUsageProgress.Views.WebViewHostWindow"
        Title="Sign in to Cursor"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
        <Border x:Name="SignInBanner"
                Grid.Row="0"
                Padding="16,12"
                IsVisible="False"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <SelectableTextBlock x:Name="SignInBannerText"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Opacity="0.85"
                           Text="Sign in with your Cursor account (Google, GitHub, and two-factor authentication work here). This window closes by itself when the session is accepted. If you already see your Cursor account, click Continue."/>
                <Button x:Name="ContinueButton"
                        Grid.Column="1"
                        Content="Continue"
                        VerticalAlignment="Center"
                        Click="OnContinueClick"
                        Classes="accent"/>
            </Grid>
        </Border>
        <NativeWebView x:Name="Browser" Grid.Row="1"/>
    </Grid>
</Window>
