<Window
    x:Class="CursorQuotaProgress.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48"
              Background="Transparent" Padding="12,0">
            <TextBlock Text="Cursor Quota Progress"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.8"/>
        </Grid>

        <!-- Body: info cards + list/edit panel -->
        <Grid Grid.Row="1" Padding="16,0,16,0" RowDefinitions="Auto,*">

            <!-- Info cards row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="Cycle start" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        <TextBlock Text="{Binding CycleStartText}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="Next renewal" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        <TextBlock Text="{Binding NextRenewalText}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="Cursor Models today" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        <TextBlock Text="{Binding CursorModelsTodayText}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="Other Models today" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        <TextBlock Text="{Binding OtherModelsTodayText}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- List + edit panel -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

                <!-- Days list -->
                <ListView x:Name="DaysList" Grid.Column="0"
                          ItemsSource="{Binding Days}"
                          SelectionChanged="OnDaySelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="12,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="52,120,*,*">
                                <TextBlock Grid.Column="0" Text="{Binding DayNumber}"
                                           VerticalAlignment="Center"
                                           Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DateText}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding CursorModelsText}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                    <ProgressBar Value="{Binding CursorModelsValue}"
                                                 Maximum="100" Height="4"
                                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{Binding OtherModelsText}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                    <ProgressBar Value="{Binding OtherModelsValue}"
                                                 Maximum="100" Height="4"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Edit panel -->
                <Border x:Name="EditPanel" Grid.Column="1"
                        Width="240"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Padding="20,16"
                        Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="EditPanelTitle"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Cursor Models %" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                            <NumberBox x:Name="CursorModelsBox"
                                       Minimum="0" Maximum="100"
                                       SmallChange="1" LargeChange="5"
                                       SpinButtonPlacementMode="Compact"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Other Models %" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                            <NumberBox x:Name="OtherModelsBox"
                                       Minimum="0" Maximum="100"
                                       SmallChange="1" LargeChange="5"
                                       SpinButtonPlacementMode="Compact"/>
                        </StackPanel>

                        <Button Content="Apply" HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnApplyEdit"/>

                        <Button Content="Cancel" HorizontalAlignment="Stretch"
                                Click="OnCancelEdit"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="16,12" ColumnDefinitions="*,Auto,Auto">
            <ToggleSwitch Grid.Column="0"
                          Header="Run at Windows sign-in"
                          IsOn="{Binding RunAtStartup, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0"/>
            <Button Grid.Column="1" Content="Change renewal day"
                    Command="{Binding ChangeRenewalDayCommand}"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Quit"
                    Command="{Binding QuitCommand}"/>
        </Grid>

    </Grid>
</Window>
