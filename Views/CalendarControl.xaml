<UserControl
    x:Class="CursorUsageProgress.Views.CalendarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CursorUsageProgress.ViewModels"
    xmlns:converters="using:CursorUsageProgress.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:TodayToBackgroundConverter x:Key="TodayToBackgroundConverter"/>
        <converters:TodayToFontWeightConverter x:Key="TodayToFontWeightConverter"/>
        <converters:RenewalDayToBackgroundConverter x:Key="RenewalDayToBackgroundConverter"/>        <converters:RunOutDayToBackgroundConverter x:Key="RunOutDayToBackgroundConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True"/>
        <converters:BoolToColorConverter x:Key="QuotaCompareBrushConverter"
                                         TrueColor="#C47A7A"
                                         FalseColor="#6A9E7C"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Day names header - uses ItemsRepeater to match grid width exactly -->
        <ItemsRepeater Grid.Row="0" Margin="0,0,0,8" ItemsSource="{x:Bind DayNames}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" Spacing="1"/>
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Width="100" Padding="0,6">
                        <TextBlock Text="{x:Bind}"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.5"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- Calendar grid: weeks x 7 days -->
        <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Weeks, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Vertical" Spacing="1"/>
            </ItemsRepeater.Layout>


            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarWeekViewModel">
                    <!-- Week row -->
                    <ItemsRepeater ItemsSource="{x:Bind Cells}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="1"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarCellViewModel">
                                <!-- Cell border with no gaps or margins -->
                                <Border Width="100" Height="85"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="0"
                                        Opacity="{x:Bind CellOpacity}"
                                        PointerPressed="OnCellPointerPressed"
                                        Tag="{x:Bind}">

                                    <Grid>
                                        <!-- Base background -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"/>

                                        <!-- Renewal day subtle overlay - fills entire area -->
                                        <Border Background="{x:Bind IsRenewalDay, Converter={StaticResource RenewalDayToBackgroundConverter}}"/>

                                        <!-- Run-out subtle overlay - fills entire area -->
                                        <Border Background="{x:Bind IsRunOutDay, Converter={StaticResource RunOutDayToBackgroundConverter}}"/>

                                        <!-- Today subtle overlay - fills entire area -->
                                        <Border Background="{x:Bind IsToday, Converter={StaticResource TodayToBackgroundConverter}, Mode=OneWay}"/>

                                        <Grid Padding="0" RowDefinitions="Auto,Auto,Auto">
                                            <!-- Day number: accent blue when this day's quota was edited -->
                                            <Grid Grid.Row="0" Margin="6,4,0,0">
                                                <TextBlock Text="{x:Bind DayNumberText}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Visibility="{x:Bind HasAccentDayNumber, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind DayNumberText}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"
                                                           Foreground="#1D4ED8"
                                                           Visibility="{x:Bind IsModified, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind DayNumberText}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"
                                                           Foreground="#0F766E"
                                                           Visibility="{x:Bind ShowAsActual, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                            </Grid>

                                            <!-- Cursor Models: renewal-paced quota (left) vs burn estimate (right) -->
                                            <Grid Grid.Row="1" Margin="6,8,6,2" Visibility="{x:Bind HasData}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Normal"
                                                    Foreground="#999999"
                                                    Text="{x:Bind ExpectedCursorText, Mode=OneWay}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ProjectedCursorText, Mode=OneWay}"
                                                    Foreground="{x:Bind CursorProjectedAtOrAbove100, Converter={StaticResource QuotaCompareBrushConverter}, Mode=OneWay}"
                                                    Visibility="{x:Bind HasCursorProjection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            </Grid>

                                            <!-- Other Models: renewal-paced quota (left) vs burn estimate (right) -->
                                            <Grid Grid.Row="2" Margin="6,0,6,4" Visibility="{x:Bind HasData}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Normal"
                                                    Foreground="#999999"
                                                    Text="{x:Bind ExpectedOtherText, Mode=OneWay}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ProjectedOtherText, Mode=OneWay}"
                                                    Foreground="{x:Bind OtherProjectedAtOrAbove100, Converter={StaticResource QuotaCompareBrushConverter}, Mode=OneWay}"
                                                    Visibility="{x:Bind HasOtherProjection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

    </Grid>
</UserControl>

