<Window
    x:Class="CursorUsageProgress.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CursorUsageProgress.Converters"
    xmlns:local="using:CursorUsageProgress.Views"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <!-- Custom title bar with seamless background -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid Padding="16,0,150,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Cursor Usage Progress"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           FontSize="13"
                           Opacity="0.9"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnResetClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Reset" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnSettingsClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnQuitClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Quit" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Body: info cards + calendar/edit panel -->
        <Grid Grid.Row="1" Padding="16,16,16,16" RowDefinitions="Auto,*">

            <!-- Info cards row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Cycle start" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding CycleStartText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Next renewal" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding NextRenewalText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Cursor Models run out" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding CursorModelsRunOutText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Other Models run out" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding OtherModelsRunOutText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Calendar + edit panel (panel only occupies space while editing) -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

                <!-- Calendar -->
                <local:CalendarControl x:Name="CalendarView"
                                       Weeks="{Binding Calendar.Weeks, Mode=OneWay}"
                                       CellSelected="OnCellSelected"/>

                <!-- Edit panel -->
                <Border Grid.Column="1" Width="220" Padding="12" Margin="16,0,0,0"
                        Visibility="{x:Bind ViewModel.EditPanelVisibility, Mode=OneWay}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind ViewModel.EditingDayText, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.CancelEditCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Cursor Models Quota" FontSize="12" Opacity="0.8"/>
                            <NumberBox x:Name="CursorQuotaBox"
                                       Value="{x:Bind ViewModel.EditingCursorQuota, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1"
                                       LargeChange="10"
                                       Minimum="0" Maximum="1000000"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Other Models Quota" FontSize="12" Opacity="0.8"/>
                            <NumberBox x:Name="OtherQuotaBox"
                                       Value="{x:Bind ViewModel.EditingOtherQuota, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1"
                                       LargeChange="10"
                                       Minimum="0" Maximum="1000000"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Content="Reset"
                                    Click="OnResetDayClick"
                                    HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1"
                                    Content="Apply"
                                    Click="OnApplyClick"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Window>
