    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://CursorUsageProgress/Assets/cursor_usage_progress.ico"
                      ToolTipText="Cursor Usage Progress">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open"/>
                        <NativeMenuItem Header="Quit"/>
                    </NativeMenu>
