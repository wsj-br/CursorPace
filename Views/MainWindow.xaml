<Window x:Class="CursorQuotaProgress.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cursor Quota Progress"
        Height="600" Width="750"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="TodayRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderTextStyle}" Text="Current Cycle:"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CycleStartText}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource HeaderTextStyle}" Text="Next Renewal:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding NextRenewalText}"/>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Available Today:"/>
                <TextBlock Style="{StaticResource ValueTextStyle}" Margin="5,0">
                    <Run Text="Cursor Models: "/>
                    <Run Text="{Binding CursorModelsTodayText, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Style="{StaticResource ValueTextStyle}" Margin="15,0,0,0">
                    <Run Text="Other Models: "/>
                    <Run Text="{Binding OtherModelsTodayText, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox DockPanel.Dock="Left" Content="Run at Windows sign-in"
                      IsChecked="{Binding RunAtStartup}"
                      VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Quit" Width="75"
                    Command="{Binding QuitCommand}"
                    HorizontalAlignment="Right"/>
            <Button DockPanel.Dock="Right" Content="Change Renewal Day" Width="150"
                    Command="{Binding ChangeRenewalDayCommand}"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"/>
        </DockPanel>

        <DataGrid x:Name="CycleDataGrid"
                  ItemsSource="{Binding Days}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  RowStyle="{StaticResource TodayRowStyle}"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Day" Binding="{Binding DayNumber}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Cursor Models %" Binding="{Binding CursorModelsText, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <DataGridTextColumn Header="Other Models %" Binding="{Binding OtherModelsText, UpdateSourceTrigger=LostFocus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
