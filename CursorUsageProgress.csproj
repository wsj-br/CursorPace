<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxGenerateProjectPriFile>true</AppxGenerateProjectPriFile>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <!-- EnableMsixTooling still runs MSIX architecture checks. RID-less
         dotnet test / build uses Platform=AnyCPU and no RuntimeIdentifier. -->
    <AllowNeutralPackageWithAppHost>true</AllowNeutralPackageWithAppHost>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\cursor_usage_progress.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Company>https://github.com/wsj-br/CursorUsageProgress</Company>
    <Product>Cursor Usage Progress</Product>
    <Copyright>Copyright © 2026 Waldemar Scudeller Jr.</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="*Tests.cs" />
    <Compile Remove="UnitTest1.cs" />
    <None Remove="*.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\cursor_usage_progress.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\cursor_usage_progress.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
  </ItemGroup>

  <!-- Unpackaged WinUI looks for resources.pri or $(AssemblyName).pri next to the exe.
       EnableMsixTooling generates the PRI, but dotnet publish does not always copy it. -->
  <Target Name="CopyUnpackagedPriToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_UnpackagedPri Condition="Exists('$(OutputPath)$(AssemblyName).pri')">$(OutputPath)$(AssemblyName).pri</_UnpackagedPri>
      <_UnpackagedPri Condition="'$(_UnpackagedPri)' == '' and Exists('$(PublishDir)$(AssemblyName).pri')">$(PublishDir)$(AssemblyName).pri</_UnpackagedPri>
      <_UnpackagedPri Condition="'$(_UnpackagedPri)' == '' and Exists('$(PublishDir)resources.pri')">$(PublishDir)resources.pri</_UnpackagedPri>
      <_UnpackagedPri Condition="'$(_UnpackagedPri)' == '' and Exists('$(OutputPath)resources.pri')">$(OutputPath)resources.pri</_UnpackagedPri>
    </PropertyGroup>
    <Error Condition="'$(_UnpackagedPri)' == ''"
           Text="Unpackaged WinUI publish did not produce $(AssemblyName).pri or resources.pri. The installed app will exit immediately (Microsoft.UI.Xaml.dll 0xc000027b)." />
    <Copy SourceFiles="$(_UnpackagedPri)" DestinationFiles="$(PublishDir)$(AssemblyName).pri" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_UnpackagedPri)" DestinationFiles="$(PublishDir)resources.pri" SkipUnchangedFiles="true" />
  </Target>

</Project>
