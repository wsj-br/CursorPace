<Window
    x:Class="CursorUsageProgress.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CursorUsageProgress.Views"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid Padding="16,0,150,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Cursor Usage Progress"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           FontSize="13"
                           Opacity="0.9"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnSettingsClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnQuitClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Quit" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Padding="16,16,16,16" RowDefinitions="Auto,*">

            <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Cycle start" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding CycleStartText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Next renewal" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding NextRenewalText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Cursor Models run out" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding CursorModelsRunOutText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Other Models run out" Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding OtherModelsRunOutText}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <TextBlock Text="{Binding LastSyncText}"
                       Opacity="0.55"
                       FontSize="11"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="12,8,0,0"
                        Spacing="2"
                        Visibility="{Binding IsInitialized, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button x:Name="CalendarViewButton"
                        Click="OnCalendarViewClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="Calendar">
                    <FontIcon x:Name="CalendarViewIcon"
                              FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE8C0;"
                              FontSize="18"/>
                </Button>
                <Button x:Name="ChartViewButton"
                        Click="OnChartViewClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        ToolTipService.ToolTip="Chart">
                    <FontIcon x:Name="ChartViewIcon"
                              FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE9D9;"
                              FontSize="18"/>
                </Button>
            </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="16"
                            MaxWidth="420"
                            Visibility="{Binding IsInitialized, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Sign in to Cursor to load your billing cycle and usage."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.8"/>
                    <Button Content="Sign in"
                            Command="{Binding SignInCommand}"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

                <Grid Visibility="{Binding IsInitialized, Converter={StaticResource BoolToVisibilityConverter}}">
                    <local:CalendarControl x:Name="CalendarView"
                                           Weeks="{Binding Calendar.Weeks, Mode=OneWay}"
                                           MonthHeading="{Binding Calendar.MonthHeading, Mode=OneWay}"
                                           Visibility="{Binding IsCalendarView, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <local:UsageChartControl x:Name="UsageChartView"
                                             Document="{Binding Chart.Document, Mode=OneWay}"
                                             Visibility="{Binding IsChartView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
