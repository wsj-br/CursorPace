<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CursorPace.ViewModels"
        xmlns:local="using:CursorPace.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="CursorPace.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cursor Pace"
        Width="760"
        Height="787"
        MinWidth="760"
        MinHeight="787"
        CanResize="True"
        CanMinimize="True"
        CanMaximize="True"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="48"
        Icon="avares://CursorPace/Assets/cursor_pace.ico"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

    <Grid>
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Border x:Name="TitleBarContent" Padding="16,0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerPressed="OnTitleBarPointerPressed"
                    PointerMoved="OnTitleBarPointerMoved"
                    PointerReleased="OnTitleBarPointerReleased"
                    PointerCaptureLost="OnTitleBarPointerCaptureLost"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Cursor Pace"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            chrome:WindowDecorationProperties.ElementRole="User">
                    <Button Command="{Binding RefreshNowCommand}"
                            IsVisible="{Binding !IsSettingsView}"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4"
                            ToolTip.Tip="Refresh now"
                            AutomationProperties.Name="Refresh">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSettingsCommand}"
                            IsVisible="{Binding !IsSettingsView}"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource SettingsIcon}" Width="14" Height="14"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnMinimizeClick"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="40"
                            Height="32"
                            Padding="0"
                            Margin="16,0,0,0"
                            CornerRadius="4"
                            ToolTip.Tip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <PathIcon Data="{StaticResource MinimizeIcon}"
                                  Width="14"
                                  Height="14"/>
                    </Button>

                    <Button x:Name="MaximizeButton"
                            Click="OnMaximizeClick"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="40"
                            Height="32"
                            Padding="0"
                            CornerRadius="4"
                            ToolTip.Tip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <Panel>
                            <PathIcon x:Name="MaximizeIconControl"
                                      Data="{StaticResource MaximizeIcon}"
                                      Width="14"
                                      Height="14"/>
                            <PathIcon x:Name="RestoreIconControl"
                                      Data="{StaticResource RestoreIcon}"
                                      Width="14"
                                      Height="14"
                                      IsVisible="False"/>
                        </Panel>
                    </Button>

                    <Button Click="OnWindowCloseClick"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="40"
                            Height="32"
                            Padding="0"
                            CornerRadius="4"
                            ToolTip.Tip="Hide to tray"
                            AutomationProperties.Name="Hide to tray">
                        <PathIcon Data="{StaticResource CloseIcon}"
                                  Width="14"
                                  Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="16">
        <Grid>
        <local:SettingsView IsVisible="{Binding IsSettingsView}"/>
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsMainView}">

            <Grid Margin="0,0,0,20">
                <StackPanel Spacing="8">
                    <Border IsVisible="{Binding HasSyncAlert}"
                            Background="{DynamicResource SyncAlertBrush}"
                            BorderBrush="{DynamicResource SyncAlertBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8">
                        <StackPanel Spacing="8">
                            <SelectableTextBlock Text="{Binding LastSyncText}"
                                                 TextWrapping="Wrap"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource SyncAlertForegroundBrush}"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsVisible="{Binding ShowSyncAlertSignInActions}">
                                <Button Content="Sign in"
                                        Command="{Binding SignInCommand}"
                                        Classes="accent"
                                        Padding="12,4"/>
                                <Button Content="Settings"
                                        Command="{Binding ShowSettingsCommand}"
                                        Padding="12,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="12"
                          IsVisible="{Binding IsInitialized}">

                        <Border Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel Spacing="10">
                                <StackPanel>
                                    <TextBlock Text="Cycle start" Opacity="0.6" FontSize="11"/>
                                    <SelectableTextBlock Text="{Binding CycleStartText}"
                                                         TextWrapping="Wrap"
                                                         FontWeight="SemiBold"
                                                         FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Next renewal" Opacity="0.6" FontSize="11"/>
                                    <SelectableTextBlock Text="{Binding NextRenewalText}"
                                                         TextWrapping="Wrap"
                                                         FontWeight="SemiBold"
                                                         FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel Spacing="10">
                                <StackPanel>
                                    <TextBlock Text="Cursor Models run out" Opacity="0.6" FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <SelectableTextBlock Text="{Binding CursorModelsRunOutText}"
                                                         TextWrapping="Wrap"
                                                         FontWeight="SemiBold"
                                                         Foreground="{DynamicResource ThemeAccentBrush}"
                                                         FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Other Models run out" Opacity="0.6" FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <SelectableTextBlock Text="{Binding OtherModelsRunOutText}"
                                                         TextWrapping="Wrap"
                                                         FontWeight="SemiBold"
                                                         Foreground="{DynamicResource ThemeAccentBrush}"
                                                         FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Last measure" Opacity="0.6" FontSize="11"/>
                                    <SelectableTextBlock Text="{Binding LastMeasureTimeText}"
                                                         Opacity="0.6"
                                                         FontSize="11"
                                                         VerticalAlignment="Center"/>
                                </StackPanel>
                                <SelectableTextBlock Text="{Binding LastMeasureCursorText, StringFormat='Cursor {0}'}"
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource ChartCursorTextBrush}"
                                                     FontSize="12"/>
                                <SelectableTextBlock Text="{Binding LastMeasureOtherText, StringFormat='Other {0}'}"
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource ChartOtherTextBrush}"
                                                     FontSize="12"/>
                                <SelectableTextBlock Text="{Binding LastMeasureExpectedText, StringFormat='Expected usage {0}'}"
                                                     TextWrapping="Wrap"
                                                     Opacity="0.75"
                                                     FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="16"
                            MaxWidth="420"
                            IsVisible="{Binding !IsInitialized}">
                    <SelectableTextBlock Text="{Binding EmptyStateText}"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center"
                                         Opacity="0.8"/>
                    <ProgressBar IsIndeterminate="True"
                                 Width="160"
                                 Height="4"
                                 HorizontalAlignment="Center"
                                 IsVisible="{Binding IsSyncing}"/>
                    <Button Content="Sign in"
                            Command="{Binding SignInCommand}"
                            HorizontalAlignment="Center"
                            Classes="accent"
                            IsVisible="{Binding ShowEmptySignIn}"/>
                </StackPanel>

                <Grid IsVisible="{Binding IsInitialized}" RowDefinitions="Auto,*">
                    <StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,4">
                            <Button Grid.Column="0"
                                    Command="{Binding GoToPreviousCycleCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    ToolTip.Tip="Previous cycle"
                                    AutomationProperties.Name="Previous cycle">
                                <PathIcon Data="{StaticResource BackIcon}"
                                          Width="18"
                                          Height="18"/>
                            </Button>
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding CycleHeading}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center"
                                                 FontSize="20"
                                                 FontWeight="SemiBold"
                                                 LetterSpacing="1.6"
                                                 Opacity="0.88"
                                                 Margin="8,0"/>
                            <Button Grid.Column="2"
                                    Command="{Binding GoToNextCycleCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    ToolTip.Tip="Next cycle"
                                    AutomationProperties.Name="Next cycle">
                                <PathIcon Data="{StaticResource ForwardIcon}"
                                          Width="18"
                                          Height="18"/>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                    Margin="0,0,0,10"
                                    IsVisible="{Binding !HasSyncAlert}">
                            <ProgressBar IsIndeterminate="True"
                                         Width="80"
                                         Height="4"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsSyncing}"/>
                            <SelectableTextBlock Text="{Binding LastSyncText}"
                                                 Opacity="0.55"
                                                 FontSize="11"
                                                 VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <local:UsageChartControl x:Name="UsageChartView"
                                             Grid.Row="1"
                                             Document="{Binding Chart.Document}"
                                             SelectedRange="{Binding Chart.SelectedRange, Mode=TwoWay}"
                                             CustomViewport="{Binding Chart.CustomViewport, Mode=TwoWay}"/>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        </Border>
    </Grid>

        <Border x:Name="ResizeGripN" Height="8" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeNorthSouth"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeN"/>
        <Border x:Name="ResizeGripS" Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeNorthSouth"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeS"/>
        <Border x:Name="ResizeGripW" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWestEast"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeW"/>
        <Border x:Name="ResizeGripE" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWestEast"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeE"/>
        <Border x:Name="ResizeGripNW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent"
                Cursor="TopLeftCorner"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW"/>
        <Border x:Name="ResizeGripNE" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent"
                Cursor="TopRightCorner"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE"/>
        <Border x:Name="ResizeGripSW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomLeftCorner"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW"/>
        <Border x:Name="ResizeGripSE" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="BottomRightCorner"
                PointerPressed="OnResizeGripPressed"
                PointerMoved="OnResizeGripMoved"
                PointerReleased="OnResizeGripReleased"
                PointerCaptureLost="OnResizeGripCaptureLost"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE"/>
    </Grid>
</Window>
