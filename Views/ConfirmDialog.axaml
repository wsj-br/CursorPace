<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CursorUsageProgress.Views.ConfirmDialog"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <TextBlock x:Name="TitleText"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <SelectableTextBlock x:Name="BodyText"
                             Grid.Row="1"
                             Margin="0,12,0,20"
                             TextWrapping="Wrap"
                             Opacity="0.85"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" Click="OnSecondaryClick" MinWidth="80"/>
            <Button x:Name="PrimaryButton" Click="OnPrimaryClick" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
