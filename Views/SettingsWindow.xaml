<Window
    x:Class="CursorUsageProgress.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48"
              Background="Transparent" Padding="12,0">
            <TextBlock Text="Settings"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.8"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24,16,24,24">
            <StackPanel Spacing="24" MaxWidth="500">

                <!-- Cursor account -->
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding CursorAccountTitle}"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{Binding SyncStatusText}"
                               TextWrapping="Wrap"
                               Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Sign in"
                                Command="{Binding SignInCommand}"/>
                        <Button Content="Refresh now"
                                Command="{Binding RefreshNowCommand}"/>
                        <Button Content="Sign out"
                                Click="OnDisconnectClick"/>
                    </StackPanel>
                    <Grid ColumnSpacing="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch Grid.Column="0"
                                      Header="Update usage automatically"
                                      IsOn="{Binding AutoSyncEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"/>
                        <ComboBox x:Name="IntervalBox"
                                  Grid.Column="1"
                                  Header="Refresh interval (hours)"
                                  MinWidth="160"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  SelectionChanged="OnIntervalChanged"/>
                    </Grid>
                    <TextBlock Text="The billing cycle and usage come from your Cursor account after you sign in."
                               TextWrapping="Wrap"
                               Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Startup"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnSpacing="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch Grid.Column="0"
                                      Header="Run at Windows sign-in"
                                      IsOn="{Binding RunAtStartup, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"/>
                        <ToggleSwitch Grid.Column="1"
                                      Header="Start in notification tray"
                                      IsOn="{Binding StartInNotificationTray, Mode=TwoWay}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Data"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Export the current cycle, or collected usage samples, as CSV."
                               TextWrapping="Wrap"
                               Opacity="0.7"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export Cycle CSV"
                                Click="OnExportCsvClick"
                                IsEnabled="{Binding IsInitialized}"/>
                        <Button Content="Export Usage"
                                Click="OnExportUsageClick"
                                Visibility="{Binding IsCursorConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
