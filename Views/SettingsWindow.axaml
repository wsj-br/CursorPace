<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CursorUsageProgress.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="CursorUsageProgress.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Settings"
        Width="600"
        Height="620"
        CanResize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="48"
        Icon="/Assets/cursor_usage_progress.ico">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <Border x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="12,0"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"/>

        <ScrollViewer Grid.Row="1" Padding="24,16,24,24">
            <StackPanel Spacing="24" MaxWidth="500">

                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding CursorAccountTitle}" FontSize="20" FontWeight="SemiBold"/>
                    <SelectableTextBlock Text="{Binding SyncStatusText}"
                                         TextWrapping="Wrap"
                                         Opacity="0.7"
                                         FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Sign in" Command="{Binding SignInCommand}"/>
                        <Button Content="Refresh now" Command="{Binding RefreshNowCommand}"/>
                        <Button Content="Sign out" Click="OnDisconnectClick"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="48">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Update usage automatically" Opacity="0.8" FontSize="12"/>
                            <ToggleSwitch IsChecked="{Binding AutoSyncEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Refresh interval (hours)" Opacity="0.8" FontSize="12"/>
                            <ComboBox x:Name="IntervalBox"
                                      MinWidth="160"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="OnIntervalChanged"/>
                        </StackPanel>
                    </Grid>
                    <SelectableTextBlock Text="The billing cycle and usage come from your Cursor account after you sign in."
                                         TextWrapping="Wrap"
                                         Opacity="0.7"
                                         FontSize="12"/>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Startup" FontSize="20" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="48">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Launch at login" Opacity="0.8" FontSize="12"/>
                            <ToggleSwitch IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                          HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Start in notification tray" Opacity="0.8" FontSize="12"/>
                            <ToggleSwitch IsChecked="{Binding StartInNotificationTray, Mode=TwoWay}"
                                          HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Data" FontSize="20" FontWeight="SemiBold"/>
                    <SelectableTextBlock Text="Export the current cycle, or collected usage samples, as CSV."
                                         TextWrapping="Wrap"
                                         Opacity="0.7"
                                         FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export Cycle CSV"
                                Click="OnExportCsvClick"
                                IsEnabled="{Binding IsInitialized}"/>
                        <Button Content="Export Usage"
                                Click="OnExportUsageClick"
                                IsVisible="{Binding IsCursorConnected}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
