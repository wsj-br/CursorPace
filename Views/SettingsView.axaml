<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CursorPace.ViewModels"
             xmlns:loc="using:CursorPace"
             x:Class="CursorPace.Views.SettingsView"
             x:DataType="vm:MainViewModel">

    <DockPanel>
        <Button DockPanel.Dock="Top"
                Command="{Binding HideSettingsCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0,0,12,0"
                Margin="0,0,0,16"
                CornerRadius="8"
                HorizontalAlignment="Left"
                ToolTip.Tip="{loc:Tr 'Back'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource BackIcon}"
                          Width="22"
                          Height="22"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Tr 'Settings'}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <TabControl x:Name="SettingsTabs"
                    SelectionChanged="OnSettingsTabChanged">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </TabControl.Styles>
            <TabItem Header="{loc:Tr 'Startup &amp; Display'}"
                     AutomationProperties.Name="{loc:Tr 'Startup &amp; Display'}">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Startup'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{loc:Tr 'Launch at login and start in the notification tray.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="48">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr 'Launch at login'}" Opacity="0.8" FontSize="12"/>
                                        <ToggleSwitch IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                                      HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{loc:Tr 'Launch at login'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{loc:Tr 'Start in notification tray'}" Opacity="0.8" FontSize="12"/>
                                        <ToggleSwitch IsChecked="{Binding StartInNotificationTray, Mode=TwoWay}"
                                                      HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{loc:Tr 'Start in notification tray'}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Appearance'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{loc:Tr 'Override the interface theme, or follow the system light or dark setting.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Theme'}" Opacity="0.8" FontSize="12"/>
                                    <ComboBox x:Name="ThemeBox"
                                              MinWidth="160"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="OnThemeChanged"
                                              AutomationProperties.Name="{loc:Tr 'Theme'}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Language'}" Opacity="0.8" FontSize="12"/>
                                    <ComboBox x:Name="LanguageBox"
                                              MinWidth="160"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="OnLanguageChanged"
                                              AutomationProperties.Name="{loc:Tr 'Language'}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Chart'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{loc:Tr 'Plot every sample for intervals up to this length. Longer intervals keep the last sample of each day.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Every sample up to'}" Opacity="0.8" FontSize="12"/>
                                    <ComboBox x:Name="SampleDetailBox"
                                              MinWidth="160"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="OnSampleDetailChanged"
                                              AutomationProperties.Name="{loc:Tr 'Every sample up to'}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr 'Cursor account'}"
                     AutomationProperties.Name="{loc:Tr 'Cursor account'}">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <SelectableTextBlock Text="{Binding CursorAccountTitle}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{Binding SyncStatusText}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr 'Sign in'}"
                                            Command="{Binding SignInCommand}"
                                            IsVisible="{Binding ShowSignInButton}"/>
                                    <Button Content="{loc:Tr 'Refresh now'}" Command="{Binding RefreshNowCommand}"/>
                                    <Button Content="{loc:Tr 'Sign out'}" Click="OnDisconnectClick"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="48">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr 'Update usage automatically'}" Opacity="0.8" FontSize="12"/>
                                        <ToggleSwitch IsChecked="{Binding AutoSyncEnabled, Mode=TwoWay}"
                                                      HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{loc:Tr 'Update usage automatically'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{loc:Tr 'Refresh interval (hours)'}" Opacity="0.8" FontSize="12"/>
                                        <ComboBox x:Name="IntervalBox"
                                                  MinWidth="160"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="OnIntervalChanged"/>
                                    </StackPanel>
                                </Grid>
                                <SelectableTextBlock Text="{loc:Tr 'The billing cycle and usage come from your Cursor account after you sign in.'}"
                                                     TextWrapping="Wrap"
                                                     Opacity="0.7"
                                                     FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr 'Sync Server'}"
                     AutomationProperties.Name="{loc:Tr 'Sync Server'}">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Sync server'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{Binding RemoteSyncStatusText}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Sync with server'}" Opacity="0.8" FontSize="12"/>
                                    <ToggleSwitch IsChecked="{Binding RemoteSyncEnabled, Mode=TwoWay}"
                                                  HorizontalAlignment="Left"
                                                  AutomationProperties.Name="{loc:Tr 'Sync with server'}"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="48">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr 'Server URL'}" Opacity="0.8" FontSize="12"/>
                                        <TextBox Text="{Binding RemoteSyncUrl, Mode=TwoWay}"
                                                 PlaceholderText="{loc:Tr 'http://server:8000'}"
                                                 AutomationProperties.Name="{loc:Tr 'Server URL'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{loc:Tr 'Machine name'}" Opacity="0.8" FontSize="12"/>
                                        <TextBox Text="{Binding RemoteSyncMachineName, Mode=TwoWay}"
                                                 AutomationProperties.Name="{loc:Tr 'Machine name'}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'API token'}" Opacity="0.8" FontSize="12"/>
                                    <SelectableTextBlock Text="{loc:Tr 'Create this on the Tokens page of your CursorPace Sync server.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                    <TextBox x:Name="RemoteSyncApiTokenBox"
                                             Text="{Binding RemoteSyncApiKey, Mode=TwoWay}"
                                             PasswordChar="•"
                                             AutomationProperties.Name="{loc:Tr 'API token'}">
                                        <TextBox.InnerRightContent>
                                            <Button x:Name="RemoteSyncApiTokenRevealButton"
                                                    Click="OnToggleRemoteSyncApiTokenClick"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6,4"
                                                    Margin="0,0,2,0"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip.Tip="{loc:Tr 'Show token'}"
                                                    AutomationProperties.Name="{loc:Tr 'Show API token'}">
                                                <Panel>
                                                    <PathIcon x:Name="ShowRemoteSyncApiTokenIcon"
                                                              Data="{StaticResource EyeIcon}"
                                                              Width="16"
                                                              Height="16"
                                                              Opacity="0.7"/>
                                                    <PathIcon x:Name="HideRemoteSyncApiTokenIcon"
                                                              Data="{StaticResource EyeOffIcon}"
                                                              Width="16"
                                                              Height="16"
                                                              Opacity="0.7"
                                                              IsVisible="False"/>
                                                </Panel>
                                            </Button>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr 'Re-sync now'}" Command="{Binding ResyncNowCommand}"/>
                                </StackPanel>
                                <SelectableTextBlock Text="{loc:Tr 'Shares usage samples and billing-cycle bounds with your other machines. Syncs on launch, after each new Cursor measurement, every 10 minutes, and on demand.'}"
                                                     TextWrapping="Wrap"
                                                     Opacity="0.7"
                                                     FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'CursorPace sync server'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{loc:Tr 'A CursorPace sync server can be installed by following the instructions at'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"
                                                         IsVisible="{Binding IsRemoteSyncUnconfigured}"/>
                                    <SelectableTextBlock Text="{loc:Tr 'The sync is configured. See the repository for updates or more information.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"
                                                         IsVisible="{Binding IsRemoteSyncConfigured}"/>
                                </StackPanel>
                                <HyperlinkButton NavigateUri="{Binding SyncServerRepositoryUri}"
                                                 Content="{Binding SyncServerRepositoryUrl}"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"
                                                 FontSize="12"
                                                 AutomationProperties.Name="{loc:Tr 'CursorPace Sync Server repository'}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr 'Export &amp; Backup'}"
                     AutomationProperties.Name="{loc:Tr 'Export &amp; Backup'}">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Data'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{loc:Tr 'Export the displayed cycle, or all collected usage samples, as CSV.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr 'Export Cycle CSV'}"
                                            Click="OnExportCsvClick"
                                            IsEnabled="{Binding IsInitialized}"
                                            ToolTip.Tip="{loc:Tr 'Sign in and load a billing cycle first'}"/>
                                    <Button Content="{loc:Tr 'Export Usage'}"
                                            Click="OnExportUsageClick"
                                            IsVisible="{Binding IsCursorConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'Backup'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{loc:Tr 'Save settings and usage samples as a single zip file. The Cursor sign-in session is not included.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr 'Backup'}" Click="OnBackupClick"/>
                                    <Button x:Name="RestoreButton" Click="OnRestoreClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr 'About'}"
                     AutomationProperties.Name="{loc:Tr 'About'}">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Tr 'About'}" FontSize="16" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Text="{loc:Tr 'Version, license, and source.'}"
                                                         TextWrapping="Wrap"
                                                         Opacity="0.7"
                                                         FontSize="12"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="16"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="8">
                                    <TextBlock Text="{loc:Tr 'Version'}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Column="1"
                                                         Text="{Binding AboutVersion}"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="{loc:Tr 'Build date'}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Row="1"
                                                         Grid.Column="1"
                                                         Text="{Binding AboutBuildDate}"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="{loc:Tr 'License'}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                    <SelectableTextBlock Grid.Row="2"
                                                         Grid.Column="1"
                                                         Text="{Binding AboutLicense}"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Text="{loc:Tr 'Repository'}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                    <HyperlinkButton Grid.Row="3"
                                                     Grid.Column="1"
                                                     NavigateUri="{Binding AboutRepositoryUri}"
                                                     Content="{Binding AboutRepositoryUrl}"
                                                     Padding="0"
                                                     HorizontalAlignment="Left"
                                                     FontSize="12"
                                                     AutomationProperties.Name="{loc:Tr 'GitHub repository'}"/>
                                </Grid>
                                <SelectableTextBlock Text="{Binding AboutCopyright}"
                                                     TextWrapping="Wrap"
                                                     FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
