<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CursorUsageProgress.ViewModels"
        xmlns:local="using:CursorUsageProgress.Views"
        x:Class="CursorUsageProgress.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cursor Usage Progress"
        Width="760"
        Height="787"
        CanResize="False"
        CanMaximize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="48"
        Icon="/Assets/cursor_usage_progress.ico"
        WindowStartupLocation="Manual">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Border x:Name="TitleBarContent" Padding="16,0,150,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Cursor Usage Progress"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Opacity="0.9"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnSettingsClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource SettingsIcon}" Width="14" Height="14"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Click="OnQuitClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource CloseIcon}" Width="14" Height="14"/>
                            <TextBlock Text="Quit" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="16">
        <Grid RowDefinitions="Auto,*">

            <Grid Margin="0,0,0,20" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Cycle start" Opacity="0.6" FontSize="11"/>
                                <SelectableTextBlock Text="{Binding CycleStartText}"
                                                     FontWeight="SemiBold"
                                                     FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Next renewal" Opacity="0.6" FontSize="11"/>
                                <SelectableTextBlock Text="{Binding NextRenewalText}"
                                                     FontWeight="SemiBold"
                                                     FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Cursor Models run out" Opacity="0.6" FontSize="11"/>
                                <SelectableTextBlock Text="{Binding CursorModelsRunOutText}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource ThemeAccentBrush}"
                                                     FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Other Models run out" Opacity="0.6" FontSize="11"/>
                                <SelectableTextBlock Text="{Binding OtherModelsRunOutText}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource ThemeAccentBrush}"
                                                     FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <SelectableTextBlock Text="{Binding LastSyncText}" Opacity="0.55" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="12,8,0,0"
                            Spacing="2"
                            IsVisible="{Binding IsInitialized}">
                    <Button x:Name="CalendarViewButton"
                            Click="OnCalendarViewClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            ToolTip.Tip="Calendar">
                        <PathIcon x:Name="CalendarViewIcon"
                                  Data="{StaticResource CalendarIcon}"
                                  Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="ChartViewButton"
                            Click="OnChartViewClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            ToolTip.Tip="Chart">
                        <PathIcon x:Name="ChartViewIcon"
                                  Data="{StaticResource ChartIcon}"
                                  Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="16"
                            MaxWidth="420"
                            IsVisible="{Binding !IsInitialized}">
                    <SelectableTextBlock Text="Sign in to Cursor to load your billing cycle and usage."
                                         TextWrapping="Wrap"
                                         TextAlignment="Center"
                                         Opacity="0.8"/>
                    <Button Content="Sign in"
                            Command="{Binding SignInCommand}"
                            HorizontalAlignment="Center"
                            Classes="accent"/>
                </StackPanel>

                <Grid IsVisible="{Binding IsInitialized}">
                    <local:CalendarControl x:Name="CalendarView"
                                           Weeks="{Binding Calendar.Weeks}"
                                           MonthHeading="{Binding Calendar.MonthHeading}"
                                           IsVisible="{Binding IsCalendarView}"/>
                    <local:UsageChartControl x:Name="UsageChartView"
                                             Document="{Binding Chart.Document}"
                                             IsVisible="{Binding IsChartView}"/>
                </Grid>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
