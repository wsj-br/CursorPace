<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\cursor_pace.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Company>https://github.com/wsj-br/CursorPace</Company>
    <Product>Cursor Pace</Product>
    <Copyright>Copyright © 2026 Waldemar Scudeller Jr.</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDateUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="*Tests.cs" />
    <Compile Remove="UnitTest1.cs" />
    <None Remove="*.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\cursor_pace.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\cursor_pace.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CursorPace.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <UseMacWebViewCompatibility Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(MSBuildProjectDirectory)/vendor/Avalonia.Controls.WebView/12.1.0/lib/net10.0/Avalonia.Controls.WebView.dll') And Exists('$(MSBuildProjectDirectory)/vendor/Avalonia.Controls.WebView/12.1.0/lib/net10.0/Avalonia.Controls.WebView.Core.dll')">true</UseMacWebViewCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0">
      <ExcludeAssets Condition="'$(UseMacWebViewCompatibility)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseMacWebViewCompatibility)' == 'true'">
    <Reference Include="Avalonia.Controls.WebView">
      <HintPath>vendor/Avalonia.Controls.WebView/12.1.0/lib/net10.0/Avalonia.Controls.WebView.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Avalonia.Controls.WebView.Core">
      <HintPath>vendor/Avalonia.Controls.WebView/12.1.0/lib/net10.0/Avalonia.Controls.WebView.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
