<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CursorUsageProgress.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush">#F3F3F3</SolidColorBrush>
                    <SolidColorBrush x:Key="CardStrokeBrush">#D0D0D0</SolidColorBrush>
                    <SolidColorBrush x:Key="CalendarActualDayBrush">#0F766E</SolidColorBrush>
                    <SolidColorBrush x:Key="CalendarMutedForegroundBrush">#6B6B6B</SolidColorBrush>
                    <SolidColorBrush x:Key="QuotaOverPaceBrush">#C47A7A</SolidColorBrush>
                    <SolidColorBrush x:Key="QuotaUnderPaceBrush">#6A9E7C</SolidColorBrush>
                    <SolidColorBrush x:Key="SyncAlertBrush">#C47A7A</SolidColorBrush>
                    <Color x:Key="ChartCursorExpectedColor">#2563EB</Color>
                    <Color x:Key="ChartOtherExpectedColor">#EA580C</Color>
                    <Color x:Key="ChartCursorEstimatedColor">#15803D</Color>
                    <Color x:Key="ChartOtherEstimatedColor">#0284C7</Color>
                    <Color x:Key="ChartGridLineColor">#28808080</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush">#2B2B2B</SolidColorBrush>
                    <SolidColorBrush x:Key="CardStrokeBrush">#3F3F3F</SolidColorBrush>
                    <SolidColorBrush x:Key="CalendarActualDayBrush">#5EEAD4</SolidColorBrush>
                    <SolidColorBrush x:Key="CalendarMutedForegroundBrush">#A3A3A3</SolidColorBrush>
                    <SolidColorBrush x:Key="QuotaOverPaceBrush">#E8A0A0</SolidColorBrush>
                    <SolidColorBrush x:Key="QuotaUnderPaceBrush">#86C29A</SolidColorBrush>
                    <SolidColorBrush x:Key="SyncAlertBrush">#E8A0A0</SolidColorBrush>
                    <Color x:Key="ChartCursorExpectedColor">#60A5FA</Color>
                    <Color x:Key="ChartOtherExpectedColor">#FB923C</Color>
                    <Color x:Key="ChartCursorEstimatedColor">#4ADE80</Color>
                    <Color x:Key="ChartOtherEstimatedColor">#38BDF8</Color>
                    <Color x:Key="ChartGridLineColor">#40A3A3A3</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

